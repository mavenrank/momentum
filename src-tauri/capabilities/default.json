{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Read and write the planner store, and let the user point it at a different folder.",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "dialog:allow-open",

    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-remove",
    "fs:allow-rename",

    "fs:scope-appdata-recursive"
  ]
}
